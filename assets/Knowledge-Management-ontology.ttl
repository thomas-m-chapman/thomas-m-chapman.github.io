#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:Acknowledgement
                Knowledge-Management:Affidavit
                Knowledge-Management:Authorization
                Knowledge-Management:Contract
                Knowledge-Management:Warranty
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:AllStaff
                Knowledge-Management:BusinessUnit
                Knowledge-Management:ProductUsers
                Knowledge-Management:WorkingGroup
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:Approve
                Knowledge-Management:Archive
                Knowledge-Management:Audit
                Knowledge-Management:Curate
                Knowledge-Management:Enforce
                Knowledge-Management:Review
                Knowledge-Management:Validate
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:ArtificialIntelligence
                Knowledge-Management:BusinessProcessManagement
                Knowledge-Management:ChangeManagement
                Knowledge-Management:DataGovernance
                Knowledge-Management:InformationArchitecture
                Knowledge-Management:LearningAndDevelopment
                Knowledge-Management:OrganizationalDevelopment
                Knowledge-Management:ProjectManagement
                Knowledge-Management:TechnicalWriting
                Knowledge-Management:UserExperience
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:Assign
                Knowledge-Management:Resolve
                Knowledge-Management:Triage
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( Knowledge-Management:Capture
                Knowledge-Management:Create
                Knowledge-Management:Edit
                Knowledge-Management:Publish
                Knowledge-Management:Strategize
                Knowledge-Management:Structure
              )
] .


