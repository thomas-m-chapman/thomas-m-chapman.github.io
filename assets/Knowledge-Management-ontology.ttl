###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#Published
Knowledge-Management:Published rdf:type owl:NamedIndividual ,
                                        Knowledge-Management:LifecycleStage ;
                               Knowledge-Management:transitionsTo Knowledge-Management:Deprecated ,
                                                                  Knowledge-Management:Expired ;
                               rdfs:comment "The lifecycle stage in which a knowledge asset is actively available to its intended audience and considered authoritative for its defined scope." .


###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#RP-Compliance-7Year
Knowledge-Management:RP-Compliance-7Year rdf:type owl:NamedIndividual ,
                                                  Knowledge-Management:RetentionPolicy ;
                                         Knowledge-Management:dispositionActivity "Review" ;
                                         Knowledge-Management:retentionPeriod 7 ;
                                         Knowledge-Management:retentionType "Compliance" ;
                                         Knowledge-Management:retentionUnit "Years" ;
                                         rdfs:comment "The compliance retention policy is applied to documents that must be retained beyond the standard legal period for regulatory or audit obligations." ;
                                         rdfs:label "Compliance 7-Year Retention" .


###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#RP-Legal-6Year
Knowledge-Management:RP-Legal-6Year rdf:type owl:NamedIndividual ,
                                             Knowledge-Management:RetentionPolicy ;
                                    Knowledge-Management:dispositionActivity "Review" ;
                                    Knowledge-Management:retentionPeriod 6 ;
                                    Knowledge-Management:retentionType "Legal" ;
                                    Knowledge-Management:retentionUnit "Years" ;
                                    rdfs:comment "The legal retention policy is applied to member-facing financial documents, legal agreements, and regulated communications. Reflects the organization's accepted legal retention requirement." ;
                                    rdfs:label "Legal 6-Year Retention" .


###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#RP-Operational-3Year
Knowledge-Management:RP-Operational-3Year rdf:type owl:NamedIndividual ,
                                                   Knowledge-Management:RetentionPolicy ;
                                          Knowledge-Management:dispositionActivity "Review" ;
                                          Knowledge-Management:retentionPeriod 3 ;
                                          Knowledge-Management:retentionType "Operations" ;
                                          Knowledge-Management:retentionUnit "Years" ;
                                          rdfs:comment "The operational retention policy is applied to procedural, reference, and other such assets that capture and define current operating best practices. The retention period of three years supports audits and process continuity, and protects against the accumulation of outdated content." ;
                                          rdfs:label "Operational 3-Year Retention" .


###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#RP-PermanentPreservation
Knowledge-Management:RP-PermanentPreservation rdf:type owl:NamedIndividual ,
                                                       Knowledge-Management:RetentionPolicy ;
                                              Knowledge-Management:dispositionActivity "PreservePermanently" ;
                                              Knowledge-Management:retentionPeriod 9999 ;
                                              Knowledge-Management:retentionType "Operations" ;
                                              Knowledge-Management:retentionUnit "Years" ;
                                              rdfs:comment "The permanent preservation policy is applied to foundational assets that either define an organizational or document institutional history, such as governance documents (policies, standards, guidelines, etc.) and the Enterprise Glossary. There is no expiration date, as content is never deleted. In this ontology, the retention period is set to the sentinel value 9999 to indicate permanent preservation." ;
                                              rdfs:label "Permanent Preservation" .


###  http://www.semanticweb.org/thoma/ontologies/2026/02/Knowledge-Management#RP-ShortTerm-1Year
Knowledge-Management:RP-ShortTerm-1Year rdf:type owl:NamedIndividual ,
                                                 Knowledge-Management:RetentionPolicy ;
                                        Knowledge-Management:dispositionActivity "Review" ;
                                        Knowledge-Management:retentionPeriod 1 ;
                                        Knowledge-Management:retentionType "Operations" ;
                                        Knowledge-Management:retentionUnit "Years" ;
                                        rdfs:comment "The short-term retention policy is applied to ephemeral content that are useful in the short term but have limited long-term value. Examples include meeting notes, draft documents, and informal communications." ;
                                        rdfs:label "Short-Term 1-Year Retention" .


