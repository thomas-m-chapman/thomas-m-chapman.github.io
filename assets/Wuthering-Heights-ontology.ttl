###  http://www.semanticweb.org/thoma/ontologies/2026/3/WutheringHeights/Linton_Heathcliff
:Linton_Heathcliff rdf:type owl:NamedIndividual ,
                            :Character ;
                   :belongsToFamily :Heathcliff_Family ,
                                    :Linton_Family ;
                   :belongsToGeneration :TheSurvivingGeneration ;
                   :hasFather :Heathcliff ;
                   :hasMother :Isabella_Linton ;
                   :hasPrimaryResidence :Wuthering_Heights ;
                   :hasSocialClass :MinorGentry ,
                                   :Outsider ;
                   :hasSpouse :Cathy_Linton ;
                   :hasBirthDate "1784"^^xsd:gYear ;
                   :hasDeathDate "1801"^^xsd:gYear ;
                   :hasSexAssignedAtBirth "male" ;
                   :hasWeddingDate "1801"^^xsd:gYear ;
                   :isGentleman "false"^^xsd:boolean ;
                   :survivesToEnd "false"^^xsd:boolean ;
                   rdfs:comment "Linton marries Cathy but is soon consumed by his own sickness and dies later that year, fulfilling Heathcliff's manipulation to transfer the Linton inheritance to himself through Cathy." ;
                   rdfs:label "Linton Heathcliff" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Linton_Heathcliff ;
   owl:annotatedProperty :belongsToFamily ;
   owl:annotatedTarget :Heathcliff_Family ;
   rdfs:comment "Linton is born a Heathcliff but carries Linton blood through his mother, Isabella. His marriage to Cathy, engineered by Heathcliff, serves to transfer the Linton inheritance to Heathcliff, dispossessing the Linton family line."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Linton_Heathcliff ;
   owl:annotatedProperty :hasPrimaryResidence ;
   owl:annotatedTarget :Wuthering_Heights ;
   rdfs:comment "Linton's primary residence is Wuthering Heights, though he is raised elsewhere by his mother, Isabella, following her escape from Heathcliff. Following Isabella's death, Heathcliff returns Linton to Wuthering Heights, where he remains until he dies."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Linton_Heathcliff ;
   owl:annotatedProperty :hasSocialClass ;
   owl:annotatedTarget :MinorGentry ;
   rdfs:comment "Linton, born into both the Linton and Heathcliff families, has claim to Minor Gentry status through his mother, Isabella."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Linton_Heathcliff ;
   owl:annotatedProperty :hasSocialClass ;
   owl:annotatedTarget :Outsider ;
   rdfs:comment "Linton, raised at Wuthering Heights under Heathcliff's shadow, occupies the ambiguous outsider position of his father despite his Linton heritage."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Linton_Heathcliff ;
   owl:annotatedProperty :hasSpouse ;
   owl:annotatedTarget :Cathy_Linton ;
   rdfs:comment "Linton marries Cathy but is soon consumed by his own sickness and dies later that year, fulfilling Heathcliff's manipulation to transfer the Linton inheritance to himself through Cathy."
 ] .


